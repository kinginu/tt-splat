# outputs: ignore heavy artifacts (.ply via the rule above, .png renders, .log) BUT commit the
# small machine-readable eval cards + json roll-ups — they ARE the shared NV/BH comparison record
# (so it/s, PSNR, card channels live in git, not hand-transcribed into docs).
outputs/**
!outputs/**/
!outputs/**/*.eval.json
!outputs/**/*.json
outputs/_smoke*/

# tt-metal generated / logs
generated/
*.log

# editor / os
.vscode/*
!.vscode/extensions.json
.idea/
.zed/
.DS_Store

# editor / agent tooling
.claude/

.private-docs/
